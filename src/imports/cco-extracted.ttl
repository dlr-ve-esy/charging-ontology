                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000618> ;
                                                   rdfs:label "Bicycle"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Ground Vehicle that consists of two wheels, one in front of the other, attached to a frame along with handlebars and pedals such that it is designed to receive its motive power from pedaling."@en ;
