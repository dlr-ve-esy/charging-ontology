                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000870> ;
                                                   rdfs:label "Transportation Infrastructure"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "An Infrastructure System that is designed to facilitate the movement of material entities from one location to another by providing the necessary structures for Persons to travel or for Vehicles to transport material entities."@en ;
