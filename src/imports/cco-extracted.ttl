                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
                                                   rdfs:label "Power Source"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Material Artifact that is designed to supply power to some other Artifact."@en ;
