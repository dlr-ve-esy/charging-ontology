                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000034> ;
                                                   rdfs:label "Artifact Function"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Function that inheres in some Artifact in virtue of that Artifact being designed to be used in processes that require that Function to be realized."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .


###  https://www.commoncoreontologies.org/ont00000328
