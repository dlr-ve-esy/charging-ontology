                                                   <https://www.commoncoreontologies.org/ont00001754> "https://en.wikipedia.org/w/index.php?title=Transport&oldid=1063526665"^^xsd:anyURI ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI .


