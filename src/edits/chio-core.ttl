@prefix : <http://openenergy-platform.org/ontology/chio/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix chio-core.ttl: <http://openenergy-platform.org/ontology/chio/dev/chio-core.ttl#> .
@base <http://openenergy-platform.org/ontology/chio/> .

<http://openenergy-platform.org/ontology/chio/chio-core/> rdf:type owl:Ontology ;
                                                           owl:versionIRI <http://openenergy-platform.org/ontology/chio/dev/chio-core.ttl> ;
                                                           owl:imports <http://openenergy-platform.org/ontology/chio/dev/imports/cco-extracted.ttl> ,
                                                                       <http://openenergy-platform.org/ontology/chio/dev/imports/oeo-extracted.ttl> ,
                                                                       <http://openenergy-platform.org/ontology/oeo/releases/2.1.0/imports/iao-extracted.owl> ,
                                                                       <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ;
                                                           <http://purl.org/dc/elements/1.1/license> "https://creativecommons.org/licenses/by/4.0/" .

#################################################################
#    Annotation properties
#################################################################

###  http://openenergy-platform.org/ontology/chio/CHIO_00000036
:CHIO_00000036 rdf:type owl:AnnotationProperty ;
               rdfs:label "OCPI 2.2 label" ;
               rdfs:subPropertyOf skos:altLabel .


#################################################################
#    Object Properties
#################################################################

###  http://openenergy-platform.org/ontology/chio/CHIO_00000083
:CHIO_00000083 rdf:type owl:ObjectProperty ;
               owl:inverseOf :CHIO_00000085 ;
               rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( <http://purl.obolibrary.org/obo/IAO_0000030>
                                          <https://www.commoncoreontologies.org/ont00000995>
                                        )
                          ] ;
               rdfs:comment "Information Content Entities are a special case, to own one it is not necessary to own an information bearing Entity with the ICE embedded to it. But the fact of possessing a IBE bearing the ICE could be considered as possessing the latter depending on the context and local copyright laws." ,
                            "Intended as the most general model of possession." ;
               rdfs:label "possesses" ;
               skos:definition "x possesses y iff x is an instance of an Agent and y is an instance of Material Artifact or Information Content Entity such that y bears the role of  possession of x during some time t." ;
               skos:example "By picking up a wallet I found on the street I posses it at that moment." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000085
:CHIO_00000085 rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( <http://purl.obolibrary.org/obo/IAO_0000030>
                                           <https://www.commoncoreontologies.org/ont00000995>
                                         )
                           ] ;
               rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
               rdfs:label "possessed by"@de ;
               skos:definition "b possessed by c =Def c possesses b" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000086
:CHIO_00000086 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :CHIO_00000083 ;
               owl:inverseOf :CHIO_00000088 ;
               rdfs:label "owns"@de ;
               skos:definition "x owns y iff x is an instance of an Agent and y is an instance of Material Artifact or Information Content Entity such as y exerts some externally acknowledged, time unlimited right of possession of y during time t." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000087
:CHIO_00000087 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :CHIO_00000083 ;
               owl:inverseOf :CHIO_00000089 ;
               rdfs:label "borrows"@de ;
               skos:definition "x borrows y iff x is an instance of an Agent and y is an instance of Material Artifact or Information Content Entity such as y exerts some externally acknowledged, time limited right of possession of y during time t." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000088
:CHIO_00000088 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :CHIO_00000085 ;
               rdfs:label "owned by"@de ;
               skos:definition "b owned by c =Def c owns b" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000089
:CHIO_00000089 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :CHIO_00000085 ;
               rdfs:label "borrowed by"@de ;
               skos:definition "b borrowed by c =Def c borrows b" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000090
:CHIO_00000090 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <https://www.commoncoreontologies.org/ont00001813> ;
               rdfs:label "manages"@de ;
               skos:definition "x manages y iff x is an instance of an Agent and y is an instance of a Material Entity, such that both x and y participate in some instance of a Process wherein x actively enables the realization of the function of y." .


###  http://purl.obolibrary.org/obo/BFO_0000176
<http://purl.obolibrary.org/obo/BFO_0000176> rdf:type owl:ObjectProperty .


###  http://purl.obolibrary.org/obo/BFO_0000178
<http://purl.obolibrary.org/obo/BFO_0000178> rdf:type owl:ObjectProperty ,
                                                      owl:TransitiveProperty .


#################################################################
#    Classes
#################################################################

###  http://openenergy-platform.org/ontology/chio/CHIO_00000001
:CHIO_00000001 rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000029> ;
               <http://purl.obolibrary.org/obo/IAO_0006011> "http://ontology.eil.utoronto.ca/icity/Parking/ParkingArea" ;
               rdfs:comment "A site designated by some agent to temporaly accomodate vehicles." ;
               rdfs:label "parking area"@en .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000002
:CHIO_00000002 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000001 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000176> ;
                                 owl:someValuesFrom :CHIO_00000001
                               ] ;
               <http://purl.obolibrary.org/obo/IAO_0006011> "http://ontology.eil.utoronto.ca/icity/Parking/ParkingSpace" ;
               rdfs:comment "A parking area able to hold at most one vehicle." ;
               rdfs:label "parking space"@en .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000003
:CHIO_00000003 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000226> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000178> ;
                                 owl:someValuesFrom :CHIO_00000001
                               ] ;
               <http://purl.obolibrary.org/obo/IAO_0006011> "http://ontology.eil.utoronto.ca/icity/Parking/ParkingFacility" ;
               rdfs:comment "A facility whose purpose is to offer space for vehicles to be left temporaly." ;
               rdfs:label "parking facility"@en .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000004
:CHIO_00000004 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000003 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000178> ;
                                 owl:someValuesFrom :CHIO_00000005
                               ] ;
               rdfs:label "charging station"@en ;
               skos:definition "A parking facility with the purpose of charging battery electric vehicles." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000005
:CHIO_00000005 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
               <http://purl.obolibrary.org/obo/IAO_0006011> "Charging station @ https://openchargealliance.org/my-oca/ocpp/" ,
                                                            "http://openenergy-platform.org/ontology/oeo/OEO_00320040" ;
               rdfs:comment "An electrical power source designed to transfer power into the traction battery of a battery electric vehicle." ;
               rdfs:label "charging column"@en .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000006
:CHIO_00000006 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000870> ;
               rdfs:label "public infrastructure" ;
               skos:definition "Public infrastructure is infrastructure owned or available for use by a public (represented by a government)." ;
               <http://www.w3.org/ns/prov#wasDerivedFrom> "https://en.wikipedia.org/wiki/Public_infrastructure" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000007
:CHIO_00000007 rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                     owl:someValuesFrom :CHIO_00000009
                                   ] ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000627> ;
               rdfs:label "transportation infrastructure element" ;
               skos:definition "A Material Entity that bears a Transportation Infrastructure Role." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000008
:CHIO_00000008 rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                     owl:someValuesFrom :CHIO_00000010
                                   ] ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000627> ;
               rdfs:label "public infrastructure element" ;
               skos:definition "A Material Entity that bears a public Infrastructure Role." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000009
:CHIO_00000009 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001141> ;
               rdfs:label "transportation infrastructure role" ;
               skos:definition "A Infrastructure Role that inheres in the elements of some transportation infrastructure." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000010
:CHIO_00000010 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001141> ;
               rdfs:label "public infrastructure role" ;
               skos:definition "A Infrastructure Role that inheres in the elements of some public infrastructure." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000011
:CHIO_00000011 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000004
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                            owl:someValuesFrom :CHIO_00000010
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :CHIO_00000004 ;
               rdfs:label "public charging station" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000012
:CHIO_00000012 rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
               <http://purl.obolibrary.org/obo/IAO_0000119> "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=151-12-19" ;
               rdfs:label "connector" ;
               skos:definition "Fiat object part of some device providing connection and disconnection to a suitable mating component" ;
               skos:example "A connector is the attachable part of the device, be it a cable or a surface." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000013
:CHIO_00000013 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000012 ;
               :CHIO_00000036 "CABLE" ;
               <http://purl.obolibrary.org/obo/IAO_0000119> "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=442-03-02" ;
               rdfs:label "plug" ;
               skos:definition "A connector attached to a cable." ;
               skos:example "Plugs are often designed with pins." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000014
:CHIO_00000014 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000012 ;
               :CHIO_00000036 "SOCKET" ;
               <http://purl.obolibrary.org/obo/IAO_0000119> "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=442-03-01" ;
               rdfs:label "outlet" ;
               skos:altLabel "socket-outlet" ;
               skos:definition "A connector attached to the surface of a device." ;
               skos:example "Outlets are designed to interact with another connector, they are often hollow sockets designed to interact with connectors with pins." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000015
:CHIO_00000015 rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
               rdfs:label "connection pattern" ;
               skos:definition "A quality of plugs and sockets which is the physical manifestation of some specification that dictates its mating suitability." ;
               skos:example "A socket built following the CEE 7 standard." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000016
:CHIO_00000016 rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000176> ;
                                 owl:someValuesFrom :CHIO_00000004
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000176> ;
                                 owl:someValuesFrom :CHIO_00000005
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000178> ;
                                 owl:someValuesFrom :CHIO_00000012
                               ] ;
               <http://purl.obolibrary.org/obo/IAO_0006011> "EVSE @ https://openchargealliance.org/my-oca/ocpp" ;
               rdfs:label "charging point" ;
               skos:definition "A fiat object part of a charging column that can deliver energy to one battery electric vehicle at a time." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000017
:CHIO_00000017 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001304> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001942> ;
                                 owl:someValuesFrom :CHIO_00000015
                               ] ;
               rdfs:label "power connector dimensional specification" ;
               skos:definition "A specification that prescribes the dimensional requirements of power connectors." ;
               skos:example "CEE7 AC plugs and sockets Standard" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000018
:CHIO_00000018 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000017 ;
               rdfs:label "electric vehicle charging system dimensional specification" ;
               skos:definition "A power connector specification that prescribes the dimensions of electric vehicle charging station connectors." ;
               skos:example "Combined Charging System (CCS)" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000024
:CHIO_00000024 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000015 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                 owl:hasValue :CHIO_00000023
                               ] ;
               :CHIO_00000036 "CHADEMO" ;
               rdfs:label "CHAdeMO pattern" ;
               skos:definition "A connection pattern built according to the IEC 62196-3 Configuration AA" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000025
:CHIO_00000025 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000015 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                 owl:hasValue :CHIO_00000020
                               ] ;
               :CHIO_00000036 "IEC_62196_T1" ;
               rdfs:label "Type 1 pattern" ;
               skos:definition "A connection pattern built according to the IEC 62196-2 Type 1" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000026
:CHIO_00000026 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000015 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                 owl:hasValue :CHIO_00000021
                               ] ;
               :CHIO_00000036 "IEC_62196_T2" ;
               rdfs:label "Type 2 pattern" ;
               skos:definition "A connection pattern built according to the IEC 62196-2 Type 2" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000027
:CHIO_00000027 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000025 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                 owl:hasValue :CHIO_00000019
                               ] ;
               :CHIO_00000036 "IEC_62196_T1_COMBO" ;
               rdfs:label "Combo 1 pattern" ;
               skos:definition "A connection pattern built according to the IEC 62196-3 Configuration EE" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000028
:CHIO_00000028 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000026 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                 owl:hasValue :CHIO_00000022
                               ] ;
               :CHIO_00000036 "IEC_62196_T2_COMBO" ;
               rdfs:label "Combo 2 pattern" ;
               skos:definition "A connection pattern built according to the IEC 62196-3 Configuration FF" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000029
:CHIO_00000029 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000012
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                            owl:someValuesFrom :CHIO_00000024
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :CHIO_00000012 ;
               rdfs:label "CHAdeMO connector" ;
               skos:altLabel "CHAdeMO" ;
               skos:definition "A connector with a CHAdeMO connection pattern" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000030
:CHIO_00000030 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000012
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                            owl:someValuesFrom :CHIO_00000025
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :CHIO_00000012 ;
               rdfs:label "Type 1 connector" ;
               skos:altLabel "J Plug" ;
               skos:definition "A connector with a Type 1 connection pattern" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000031
:CHIO_00000031 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000012
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                            owl:someValuesFrom :CHIO_00000026
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :CHIO_00000012 ;
               rdfs:label "Type 2 connector" ;
               skos:altLabel "Mennekes" ;
               skos:definition "A connector with a Type 2 connection pattern" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000032
:CHIO_00000032 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000030
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                            owl:someValuesFrom :CHIO_00000027
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :CHIO_00000030 ;
               rdfs:label "Combo 1 connector" ;
               skos:altLabel "CCS 1" ;
               skos:definition "A Type 1 connector with DC capability." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000033
:CHIO_00000033 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000031
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                            owl:someValuesFrom :CHIO_00000028
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :CHIO_00000031 ;
               rdfs:label "Combo 2 connector" ;
               skos:altLabel "CCS2" ;
               skos:definition "A Type 2 connector with DC capability" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000043
:CHIO_00000043 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000015 ;
               :CHIO_00000036 "TESLA_S" ;
               rdfs:comment "Typically used by Tesla vehicles and chargers." ;
               rdfs:label "NACS pattern" ;
               skos:definition "A connection pattern built according to the SAE J3400 specification." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000044
:CHIO_00000044 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000012
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
                                                            owl:someValuesFrom :CHIO_00000043
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :CHIO_00000012 ;
               rdfs:label "NACS connector" ;
               skos:definition "A connector with a NACS pattern." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000045
:CHIO_00000045 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000015 ;
               :CHIO_00000036 "TESLA_R" ;
               rdfs:comment "Connector used by Tesla Models before 2012." ;
               rdfs:label "Tesla Roadster pattern" ;
               skos:definition "A connection pattern used by the Tesla Roadster model." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000047
:CHIO_00000047 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000015 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <https://www.commoncoreontologies.org/ont00001920> ;
                                 owl:hasValue :CHIO_00000057
                               ] ;
               rdfs:label "industrial connection pattern" ;
               skos:definition "A connection pattern built according to the IEC 60309" .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000048
:CHIO_00000048 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
               rdfs:label "Direct Current Electrical Artifact Function" ;
               skos:definition "An Electrical Artifact Function that is realized in a process involving Direct Current." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000049
:CHIO_00000049 rdf:type owl:Class ;
               rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
               rdfs:label "Alternate Current Electrical Artifact Function" ;
               skos:definition "An Electrical Artifact Function that is realized in a process involving Alternate Current." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000050
:CHIO_00000050 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000049 ;
               rdfs:label "1 Phase Alternate Current Electrical Artifact Function" ;
               skos:definition "An Alternate Current Electrical Artifact Function that is realized in a process involving 1 Phase Alternate Current." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000051
:CHIO_00000051 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000049 ;
               rdfs:label "3 Phase Alternate Current Electrical Artifact Function" ;
               skos:definition "An Alternate Current Electrical Artifact Function that is realized in a process involving 3 Phase Alternate Current." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000052
:CHIO_00000052 rdf:type owl:Class ;
               rdfs:subClassOf :CHIO_00000015 ;
               rdfs:label "domestic connection pattern" ;
               skos:altLabel "standard connection pattern" ;
               skos:definition "A connection pattern found in general use electronics." .


###  http://openenergy-platform.org/ontology/chio/CHIO_00000053
:CHIO_00000053 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( <https://www.commoncoreontologies.org/ont00000995>
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000196> ;
