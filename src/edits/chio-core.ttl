###  http://openenergy-platform.org/ontology/chio/CHIO_00000032
:CHIO_00000032 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :CHIO_00000030
                                                          [ rdf:type owl:Restriction ;
